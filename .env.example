# Application Environment
APP_ENV=production
APP_DEBUG=false
APP_NAME="BusinessRegistry"

# Database Configuration
DB_HOST=database-santo
DB_PORT=3306
DB_NAME=mio_database
DB_USER=root
DB_PASSWORD=your_secure_password_here
ADMIN_INITIAL_PASSWORD=choose_a_unique_password_of_at_least_12_characters

# Logging
LOG_LEVEL=error
LOG_CHANNEL=file

# Security
SESSION_LIFETIME=3600
CSRF_PROTECTION=true
APP_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_characters
APP_FRONTEND_URL=http://localhost:4200

# Provisional one-time payment amounts. Change only after approving final prices.
PLAN_MONTHLY_PRICE=4.99
PLAN_YEARLY_PRICE=49.99
PAYMENT_CURRENCY=EUR

# Optional checkout providers. Card checkout remains unavailable until both Stripe values are set.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Mail (optional, for future use)
MAIL_DRIVER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# Application URLs
APP_URL=http://localhost:8081
